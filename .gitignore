# macOS
.DS_Store

# Xcode — per-user state, never shared
DerivedData/
build/
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# Build output
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.spm-build/
.build/
Packages/

# CocoaPods / Carthage (unused but cheap to guard)
Pods/
Carthage/Build/

# Playground state
timeline.xctimeline
playground.xcworkspace

# Firebase — client config is public by design (PRD §9.6)

# Secrets
.env

# Local ML tooling — coremltools + CLIP tokenizer, ~400 MB
ml/venv/
ml/__pycache__/

# MobileCLIP text tower — 121 MB, only needed to regenerate habit_vectors.json.
# Get it from Apple ml-mobileclip, or ../../CameraAI/models/, into ml/.
ml/*.mlpackage/
