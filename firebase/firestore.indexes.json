{
  "//": "PRD §9.12: 'Declare these early — Firestore fails the query rather than degrading.' Both back the Fights browse list (§6.5): chronological, optionally filtered by type.",
  "indexes": [
    {
      "collectionGroup": "events",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "startsAt", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "events",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "eventType", "order": "ASCENDING" },
        { "fieldPath": "startsAt", "order": "ASCENDING" }
      ]
    }
  ],
  "fieldOverrides": []
}
